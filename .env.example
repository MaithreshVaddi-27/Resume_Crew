# Copy to .env. Keep .env private; it can contain API keys and local file paths.
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# Default input paths (optional). Command-line / UI-selected paths always
# take precedence over these.
# ---------------------------------------------------------------------------
RESUME_PATH=./samples/Resumes/sample_resume.pdf
JD_PATH=./samples/Job_description/sample_job_description.pdf

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Choose exactly one provider for each run: mlx, ollama, or gemini.
# MLX-LM is recommended on Apple Silicon when its local server is running.
LLM_PROVIDER=mlx

# MLX-LM server: start with `mlx_lm.server --model "$MLX_MODEL"`.
MLX_BASE_URL=http://localhost:8080/v1
MLX_MODEL=mlx-community/Qwen3-4B-4bit

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Ollama connectivity timeout in seconds. Raise on slow machines or WSL2.
OLLAMA_TIMEOUT=3.0
# Hardware profile: auto detects CUDA > MPS > CPU.
OLLAMA_PROFILE=auto

# Required when LLM_PROVIDER=gemini. Sends document text to Google; leave empty
# when using Ollama to keep analysis local.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# CrewAI telemetry (disabled by default for every run — see README)
# ---------------------------------------------------------------------------
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true
OTEL_SDK_DISABLED=true

# ---------------------------------------------------------------------------
# Gradio web UI (resume-crew-ui)
# ---------------------------------------------------------------------------
# Local port for the web UI.
GRADIO_PORT=7860
# Use Gradio's built-in public tunnel instead of ngrok (true/false).
GRADIO_SHARE=false

# Optional: ngrok authtoken for a live public URL when running the Gradio app.
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Required together before NGROK_AUTHTOKEN or GRADIO_SHARE can expose the UI.
# Use a unique, strong password; the app refuses public sharing without both.
GRADIO_AUTH_USER=
GRADIO_AUTH_PASS=
